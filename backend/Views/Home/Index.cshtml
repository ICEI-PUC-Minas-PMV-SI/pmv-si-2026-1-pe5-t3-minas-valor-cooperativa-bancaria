@{
    ViewData["Title"] = "Home Page";
}

    <!-- ==================== HERO ==================== -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            O valor que você precisa, <span>a confiança que você merece.</span>
          </h1>
          <p class="hero-subtitle">
            A Minas Valor é a cooperativa que impulsiona o desenvolvimento da
            sua região, com soluções financeiras completas e atendimento humano
            de verdade.
          </p>
          <div class="hero-buttons">
            <a href="#" class="btn-primary btn-dourado"
              >Abra sua Conta Digital
              <i class="fa-solid fa-arrow-right" style="margin-left: 8px"></i
            ></a>
            <a
              href="#servicos"
              class="btn-outline"
              style="border-color: white; color: white"
              >Conheça Nossos Produtos</a
            >
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-card">
            <div class="stat-item">
              <div class="stat-number">+5 mil</div>
              <div class="stat-label">Cooperados ativos</div>
            </div>
            <div class="divider"></div>
            <div class="stat-item">
              <div class="stat-number">6</div>
              <div class="stat-label">Agências na região</div>
            </div>
            <div class="divider"></div>
            <div class="stat-item">
              <div class="stat-number">+R$ 10 mi</div>
              <div class="stat-label">Em crédito concedido</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVIÇOS ==================== -->
    <section class="section-servicos" id="servicos">
      <div class="container">
        <div class="section-header">
          <h2>Nossos Produtos e Serviços</h2>
          <p>
            Soluções financeiras pensadas para você e sua família, com as
            melhores taxas e o atendimento que só uma cooperativa oferece.
          </p>
        </div>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-building-columns"></i>
            </div>
            <h3>Conta Corrente</h3>
            <p>
              Conta digital gratuita, com transferências ilimitadas e rendimento
              automático.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-credit-card"></i>
            </div>
            <h3>Cartões de Crédito</h3>
            <p>
              Cartões com programa de pontos, anuidade zero e aceitação
              internacional.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-hand-holding-dollar"></i>
            </div>
            <h3>Empréstimos</h3>
            <p>Crédito pessoal e consignado com as menores taxas do mercado.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-house-chimney"></i>
            </div>
            <h3>Financiamentos</h3>
            <p>
              Realize o sonho da casa própria, do carro novo ou da sua empresa.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3>Seguros</h3>
            <p>Proteção para seu patrimônio, sua família e seu negócio.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-piggy-bank"></i>
            </div>
            <h3>Previdência</h3>
            <p>
              Planeje seu futuro com planos de previdência privada flexíveis.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon"><i class="fa-solid fa-ticket"></i></div>
            <h3>Consórcios</h3>
            <p>
              Adquira bens de forma programada, sem juros, com parcelas que
              cabem no seu bolso.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">
              <i class="fa-solid fa-file-invoice"></i>
            </div>
            <h3>Pagamentos</h3>
            <p>Boletos, contas de consumo e muito mais, tudo em um só lugar.</p>
          </div>
        </div>
      </div>
    </section>

