@model System.Collections.Generic.List<minas_valor_backend.Models.User>

@{
    ViewData["Title"] = "Index";
}

<div class="container p-3">
    <h2>Usuários cadastrados</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">+ Criar nova usuário</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model[0].Role)</th>
            <th>Ações</th>
        </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@Html.DisplayFor(model => @user.Role)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">Nenhuma conta cadastrada.</td>
            </tr>
        }
        </tbody>
    </table>
</div>